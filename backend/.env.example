# Server
PORT=3203
FRONTEND_URL=http://localhost:3202

# SMTP — utiliser contact@amablanc-hre.fr (OVH)
# SMTP_HOST OVH : ssl0.ovh.net / port 465 / SMTP_SECURE=true
# OU pour test avec Gmail : smtp.gmail.com / port 587 / SMTP_SECURE=false
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=[DEMO — à remplacer]
SMTP_PASS=[DEMO — à remplacer]

# Business
AMA_EMAIL=[email réel d'Anne-Marie Blanc — ex: annemarie@gmail.com]
AMA_ADDRESS=[adresse postale — ex: 12 rue des Lilas, 75001 Paris]
AMA_SIRET=[numéro SIRET d'Anne-Marie Blanc]

# PayPal
PAYPAL_CLIENT_ID=[à remplacer par le Client ID PayPal]
PAYPAL_CLIENT_SECRET=[à remplacer par le Secret Client PayPal]
PAYPAL_MODE=sandbox
