# Copier ce fichier en .env.production et remplir les vraies valeurs sur le VPS

# Base path vide en production (domaine dédié amablanc-hre.fr)
NEXT_PUBLIC_BASE_PATH=

# API publique (domaine prod)
NEXT_PUBLIC_API_URL=https://amablanc-hre.fr

# PayPal LIVE (remplacer sandbox par live dans le backend aussi)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=LIVE_CLIENT_ID_ICI

# API interne — NE PAS CHANGER (Docker réseau interne)
API_URL=http://backend:3203

# SMTP (email de contact et réservation)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=email_envoi@gmail.com
SMTP_PASS=app_password_gmail_16_caracteres

# Email destinataire Ama
AMA_EMAIL=email_reel_ama@gmail.com
