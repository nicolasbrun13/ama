# Copier ce fichier en .env.production et remplir les vraies valeurs sur le VPS

# Base path vide en production (domaine dédié amablanc-hre.fr)
NEXT_PUBLIC_BASE_PATH=

# API publique (domaine prod)
NEXT_PUBLIC_API_URL=https://amablanc-hre.fr

# PayPal LIVE — figée au build : reconstruire quand les identifiants arrivent
# En attendant, laisser vide (PayPal désactivé)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# API interne — NE PAS CHANGER (Docker réseau interne)
API_URL=http://backend:3203

# SMTP OVH (même config que le backend)
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@amablanc-hre.fr
SMTP_PASS=mot_de_passe_ovh

# Email destinataire Ama
AMA_EMAIL=anne.marie.blanc@gmail.com
